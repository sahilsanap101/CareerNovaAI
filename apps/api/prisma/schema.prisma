// This is your Prisma schema file.
// Learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── Enums ────────────────────────────────────────────────────────

enum Role {
  STUDENT
  ADMIN
}

enum Theme {
  light
  dark
  system
}

enum Language {
  en
  hi
}

enum WorkMode {
  REMOTE
  HYBRID
  ONSITE
}

// ─── Core Models ──────────────────────────────────────────────────

model User {
  id         String   @id @default(cuid())
  fullName   String
  email      String   @unique
  password   String
  role       Role     @default(STUDENT)
  isVerified Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // Relations
  profile               Profile?
  preferences           UserPreference?
  sessions              Session[]
  auditLogs             AuditLog[]
  passwordResetTokens   PasswordResetToken[]
  verificationTokens    VerificationToken[]
  skills                UserSkill[]
  interests             UserInterest[]
  careerGoal            CareerGoal?
  projects              Project[]
  certifications        Certification[]
  codingPlatforms       CodingPlatform[]
  recommendations       RecommendationResult[]
  userRoadmaps          UserRoadmap[]
  userTasks             UserTask[]
  weeklyPlans           WeeklyPlan[]
  userAchievements      UserAchievement[]
  studySessions         StudySession[]
  conversations         Conversation[]
  aiMetrics             AiMetric[]
  feedbacks             Feedback[]
  gateProfile           UserGateProfile?
  GateQuestionAttempt   GateQuestionAttempt[]
  GateBookmark          GateBookmark[]
  GateTopicMastery      GateTopicMastery[]
  GateMistakeTracker    GateMistakeTracker[]
  GateRevisionQueue     GateRevisionQueue[]
  GateStudyPlan         GateStudyPlan[]
  GateMockAttempt       GateMockAttempt[]
  GateReadinessSnapshot GateReadinessSnapshot[]
  GateAdminAudit        GateAdminAudit[]

  @@index([email])
  @@map("users")
}

// ─── Phase 5: AI Operating System (AIOS) Models ───────────────────

model Conversation {
  id        String   @id @default(cuid())
  userId    String
  title     String   @default("New AI Session")
  agentType String   @default("CAREER_MENTOR") // CAREER_MENTOR, RESUME, GITHUB, INTERVIEW, LEARNING, RESEARCH, ROADMAP
  pinned    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages Message[]

  @@index([userId])
  @@map("conversations")
}

model Message {
  id             String   @id @default(cuid())
  conversationId String
  role           String // user, assistant, system, tool
  content        String   @db.Text
  sources        Json? // RAG Citing sources
  tokensUsed     Int?     @default(0)
  feedback       String? // HELPFUL, UNHELPFUL
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@map("messages")
}

model PromptTemplate {
  id        String   @id @default(cuid())
  name      String   @unique
  agentType String
  template  String   @db.Text
  version   Int      @default(1)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("prompt_templates")
}

model AiMetric {
  id           String   @id @default(cuid())
  userId       String
  agentType    String
  model        String   @default("gemini-1.5-pro")
  tokensInput  Int      @default(0)
  tokensOutput Int      @default(0)
  durationMs   Int      @default(0)
  cost         Float    @default(0.0)
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("ai_metrics")
}

model KnowledgeDoc {
  id        String   @id @default(cuid())
  title     String
  content   String   @db.Text
  category  String   @default("CAREER_GUIDE") // CAREER_GUIDE, ROADMAP, RESUME, INTERVIEW, RESEARCH
  tags      String[]
  createdAt DateTime @default(now())

  @@index([category])
  @@map("knowledge_docs")
}

// ─── Phase 4: Adaptive Learning & Roadmap Models ──────────────────

model Roadmap {
  id                String   @id @default(cuid())
  title             String
  careerPathId      String
  description       String   @db.Text
  difficulty        String   @default("INTERMEDIATE") // BEGINNER, INTERMEDIATE, ADVANCED
  estimatedDuration String // e.g. "16 Weeks"
  version           Int      @default(1)
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  careerPath   CareerPath     @relation(fields: [careerPathId], references: [id], onDelete: Cascade)
  phases       RoadmapPhase[]
  userRoadmaps UserRoadmap[]
  milestones   Milestone[]

  @@index([careerPathId])
  @@map("roadmaps")
}

model RoadmapPhase {
  id                   String   @id @default(cuid())
  roadmapId            String
  phaseNumber          Int
  title                String
  description          String   @db.Text
  estimatedWeeks       Int      @default(4)
  completionPercentage Float    @default(0)
  order                Int      @default(1)
  createdAt            DateTime @default(now())

  roadmap Roadmap         @relation(fields: [roadmapId], references: [id], onDelete: Cascade)
  modules RoadmapModule[]

  @@index([roadmapId])
  @@map("roadmap_phases")
}

model RoadmapModule {
  id             String   @id @default(cuid())
  phaseId        String
  title          String
  description    String   @db.Text
  difficulty     String   @default("MEDIUM")
  estimatedHours Int      @default(10)
  requiredSkills String[] // Prerequisites
  providedSkills String[] // Skills gained
  dependencies   String[] // Module IDs or Names
  order          Int      @default(1)

  phase RoadmapPhase   @relation(fields: [phaseId], references: [id], onDelete: Cascade)
  tasks LearningTask[]

  @@index([phaseId])
  @@map("roadmap_modules")
}

model LearningTask {
  id               String    @id @default(cuid())
  moduleId         String
  title            String
  description      String    @db.Text
  taskType         String    @default("PRACTICE") // THEORY, PRACTICE, PROJECT, QUIZ, REVISION
  estimatedMinutes Int       @default(60)
  difficulty       String    @default("MEDIUM")
  priority         String    @default("HIGH") // HIGH, MEDIUM, LOW
  deadline         DateTime?
  status           String    @default("PENDING") // PENDING, IN_PROGRESS, COMPLETED

  module    RoadmapModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  resources Resource[]
  userTasks UserTask[]

  @@index([moduleId])
  @@map("learning_tasks")
}

model Resource {
  id           String  @id @default(cuid())
  taskId       String
  title        String
  provider     String // e.g. "YouTube", "freeCodeCamp", "Official Docs", "Coursera"
  url          String
  resourceType String  @default("VIDEO") // VIDEO, ARTICLE, DOCUMENTATION, COURSE
  duration     String? @default("30 mins")
  language     String  @default("English")
  difficulty   String  @default("BEGINNER")
  free         Boolean @default(true)
  rating       Float   @default(4.8)

  task LearningTask @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@map("resources")
}

model UserRoadmap {
  id                   String   @id @default(cuid())
  userId               String
  roadmapId            String
  progress             Float    @default(0)
  completionPercentage Float    @default(0)
  learningPace         String   @default("MEDIUM") // FAST (20h), MEDIUM (10h), SLOW (5h)
  currentPhase         Int      @default(1)
  currentModule        String?
  startedAt            DateTime @default(now())
  lastUpdated          DateTime @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  roadmap Roadmap @relation(fields: [roadmapId], references: [id], onDelete: Cascade)

  @@unique([userId, roadmapId])
  @@index([userId])
  @@map("user_roadmaps")
}

model UserTask {
  id          String    @id @default(cuid())
  userId      String
  taskId      String
  status      String    @default("PENDING") // PENDING, COMPLETED, SKIPPED
  startedAt   DateTime?
  completedAt DateTime?
  timeSpent   Int       @default(0) // in minutes
  score       Float?
  notes       String?   @db.Text

  user User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  task LearningTask @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@unique([userId, taskId])
  @@index([userId])
  @@map("user_tasks")
}

model WeeklyPlan {
  id                   String   @id @default(cuid())
  userId               String
  weekNumber           Int
  startDate            DateTime
  endDate              DateTime
  estimatedHours       Float    @default(10)
  completedHours       Float    @default(0)
  completionPercentage Float    @default(0)
  createdAt            DateTime @default(now())

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  dailyPlans DailyPlan[]

  @@index([userId])
  @@map("weekly_plans")
}

model DailyPlan {
  id             String   @id @default(cuid())
  weeklyPlanId   String
  date           DateTime
  tasks          Json // Array of task items for the day
  estimatedHours Float    @default(2)
  completedHours Float    @default(0)
  status         String   @default("PLANNED") // PLANNED, IN_PROGRESS, COMPLETED

  weeklyPlan WeeklyPlan @relation(fields: [weeklyPlanId], references: [id], onDelete: Cascade)

  @@index([weeklyPlanId])
  @@map("daily_plans")
}

model Milestone {
  id          String    @id @default(cuid())
  roadmapId   String
  title       String
  description String    @db.Text
  targetDate  DateTime?
  status      String    @default("LOCKED") // LOCKED, IN_PROGRESS, ACHIEVED
  reward      String?   @default("Badge")

  roadmap Roadmap @relation(fields: [roadmapId], references: [id], onDelete: Cascade)

  @@index([roadmapId])
  @@map("milestones")
}

model Achievement {
  id          String   @id @default(cuid())
  title       String   @unique
  description String
  icon        String   @default("Trophy")
  badgeColor  String   @default("gold")
  criteria    Json
  createdAt   DateTime @default(now())

  userAchievements UserAchievement[]

  @@map("achievements")
}

model UserAchievement {
  id            String   @id @default(cuid())
  userId        String
  achievementId String
  earnedAt      DateTime @default(now())

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievement Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)

  @@unique([userId, achievementId])
  @@index([userId])
  @@map("user_achievements")
}

model StudySession {
  id        String    @id @default(cuid())
  userId    String
  startTime DateTime  @default(now())
  endTime   DateTime?
  duration  Int       @default(0) // in minutes
  module    String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("study_sessions")
}

// ─── Phase 3: BYSER Recommendation Models ─────────────────────────

model CareerPath {
  id            String   @id @default(cuid())
  name          String   @unique
  description   String   @db.Text
  category      String // e.g. "Software Engineering", "AI & Data", "Cyber Security", "Cloud & DevOps"
  industry      String   @default("Technology")
  averageSalary String // e.g. "12 - 25 LPA"
  growthRate    String // e.g. "22% YoY"
  demandLevel   String   @default("HIGH") // HIGH, VERY_HIGH, EXTREME
  roadmapId     String?
  icon          String?  @default("Briefcase")
  color         String?  @default("blue")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  requiredSkills  RequiredSkill[]
  recommendations RecommendationResult[]
  roadmaps        Roadmap[]

  @@index([category])
  @@map("career_paths")
}

model RequiredSkill {
  id               String @id @default(cuid())
  careerPathId     String
  skillId          String
  importanceWeight Int    @default(5) // 1 to 10

  careerPath CareerPath @relation(fields: [careerPathId], references: [id], onDelete: Cascade)
  skill      Skill      @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([careerPathId, skillId])
  @@index([careerPathId])
  @@map("required_skills")
}

model RecommendationResult {
  id           String   @id @default(cuid())
  userId       String
  careerPathId String
  totalScore   Float // 0 to 100
  SGI          Float // Skill Gap Index 0 to 100
  confidence   Float // Confidence percentage
  explanation  Json // Why recommended, strengths, and areas to improve
  generatedAt  DateTime @default(now())

  user       User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  careerPath CareerPath             @relation(fields: [careerPathId], references: [id], onDelete: Cascade)
  factors    RecommendationFactor[]
  feedbacks  Feedback[]

  @@index([userId])
  @@index([careerPathId])
  @@index([generatedAt])
  @@map("recommendation_results")
}

model RecommendationFactor {
  id               String @id @default(cuid())
  recommendationId String
  factor           String // Skills, Interests, Projects, Academic, Certifications, Coding, Goals
  weight           Float // e.g. 0.35
  score            Float // 0 to 100
  explanation      String

  recommendation RecommendationResult @relation(fields: [recommendationId], references: [id], onDelete: Cascade)

  @@index([recommendationId])
  @@map("recommendation_factors")
}

model Profile {
  id              String   @id @default(cuid())
  userId          String   @unique
  college         String?
  university      String?
  degree          String?
  branch          String?
  specialization  String?
  currentYear     Int?
  currentSemester Int?
  graduationYear  Int?
  cgpa            Float?
  bio             String?  @db.Text
  profileImage    String?
  city            String?
  country         String?  @default("India")
  gender          String?
  category        String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("profiles")
}

model UserPreference {
  id            String   @id @default(cuid())
  userId        String   @unique
  theme         Theme    @default(system)
  language      Language @default(en)
  notifications Boolean  @default(true)
  timezone      String   @default("Asia/Kolkata")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("user_preferences")
}

// ─── Phase 2: Skills & Assessment ─────────────────────────────────

model Skill {
  id        String   @id @default(cuid())
  category  String // e.g. "Programming", "Frontend", "Backend", "Database", "Cloud", "Cyber Security", "AI", "DevOps"
  name      String   @unique
  createdAt DateTime @default(now())

  userSkills     UserSkill[]
  requiredSkills RequiredSkill[]

  @@index([category])
  @@map("skills")
}

model UserSkill {
  id               String   @id @default(cuid())
  userId           String
  skillId          String
  proficiency      Int      @default(1) // 1 to 5
  experienceMonths Int      @default(0)
  confidence       Int      @default(50) // 0 to 100
  lastUpdated      DateTime @updatedAt

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  skill Skill @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([userId, skillId])
  @@index([userId])
  @@map("user_skills")
}

model Interest {
  id        String   @id @default(cuid())
  name      String   @unique
  category  String?
  createdAt DateTime @default(now())

  userInterests UserInterest[]

  @@map("interests")
}

model UserInterest {
  id         String @id @default(cuid())
  userId     String
  interestId String
  priority   Int    @default(1) // 1 to 5

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  interest Interest @relation(fields: [interestId], references: [id], onDelete: Cascade)

  @@unique([userId, interestId])
  @@index([userId])
  @@map("user_interests")
}

model CareerGoal {
  id                 String   @id @default(cuid())
  userId             String   @unique
  preferredJobRole   String?
  preferredIndustry  String?
  preferredWorkMode  WorkMode @default(HYBRID)
  preferredCountries String? // Comma separated
  expectedSalary     String?
  higherStudies      Boolean  @default(false)
  entrepreneurship   Boolean  @default(false)
  governmentJobs     Boolean  @default(false)
  startup            Boolean  @default(false)
  research           Boolean  @default(false)
  updatedAt          DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("career_goals")
}

model Project {
  id               String   @id @default(cuid())
  userId           String
  title            String
  description      String   @db.Text
  technologies     String // Comma separated or stringified
  githubUrl        String?
  demoUrl          String?
  completionStatus String   @default("COMPLETED") // COMPLETED, IN_PROGRESS, PLANNED
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("projects")
}

model Certification {
  id            String   @id @default(cuid())
  userId        String
  title         String
  issuer        String
  issueDate     String?
  credentialUrl String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("certifications")
}

model CodingPlatform {
  id             String   @id @default(cuid())
  userId         String
  platform       String // LeetCode, Codeforces, HackerRank, CodeChef, GeeksforGeeks, GitHub
  username       String
  problemsSolved Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("coding_platforms")
}

// ─── Sessions & Tokens ─────────────────────────────────────────────

model Session {
  id           String   @id @default(cuid())
  userId       String
  device       String?
  browser      String?
  ip           String?
  refreshToken String   @unique
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([refreshToken])
  @@map("sessions")
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@map("password_reset_tokens")
}

model VerificationToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@map("verification_tokens")
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  entity    String
  entityId  String?
  metadata  Json?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

model Feedback {
  id                  String   @id @default(cuid())
  userId              String
  recommendationId    String
  relevanceScore      Int // 1-5
  roadmapClarityScore Int // 1-5
  freeTextComment     String?  @db.Text
  createdAt           DateTime @default(now())

  user           User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  recommendation RecommendationResult @relation(fields: [recommendationId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([recommendationId])
  @@map("feedbacks")
}

// ─── Phase 6: GATE Preparation Module ──────────────────────────────
enum GateQuestionType {
  MCQ
  MSQ
  NAT
}

enum GateDifficulty {
  EASY
  MEDIUM
  HARD
}

enum GateStudySessionStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
  SKIPPED
}

enum GateMockStatus {
  UPCOMING
  IN_PROGRESS
  COMPLETED
}

enum GateMistakeType {
  CALCULATION
  CONCEPTUAL
  READING
  TIME_PRESSURE
}

enum GateOfficialStatus {
  OFFICIAL
  UNOFFICIAL
  VERIFIED
}

enum GateExamLifecycle {
  DRAFT
  IMPORTED
  VALIDATING
  VERIFIED
  PUBLISHED
  ARCHIVED
}

model GateExam {
  id                  String   @id @default(cuid())
  year                Int
  organizingInstitute String
  officialWebsite     String?
  isActive            Boolean           @default(true)
  lifecycleStatus     GateExamLifecycle @default(DRAFT)
  createdAt           DateTime          @default(now())

  papers         GatePaper[]
  importantDates GateImportantDate[]
  officialLinks  GateOfficialLink[]
  questions      GateQuestion[]
  studyPlans     GateStudyPlan[]
  mockTests      GateMockTest[]
  syncRecords    GateSyncRecord[]

  @@unique([year])
  @@map("gate_exams")
}

model GateImportantDate {
  id          String   @id @default(cuid())
  examId      String
  title       String
  date        DateTime
  description String?  @db.Text
  createdAt   DateTime @default(now())

  exam GateExam @relation(fields: [examId], references: [id], onDelete: Cascade)

  @@index([examId])
  @@map("gate_important_dates")
}

model GateOfficialLink {
  id          String   @id @default(cuid())
  examId      String
  title       String
  url         String
  description String?  @db.Text
  createdAt   DateTime @default(now())

  exam GateExam @relation(fields: [examId], references: [id], onDelete: Cascade)

  @@index([examId])
  @@map("gate_official_links")
}

model GatePaper {
  id        String    @id @default(cuid())
  examId    String
  paperCode String // e.g. "CS", "ME"
  paperName String // e.g. "Computer Science and Information Technology"
  examDate  DateTime?
  session   String? // e.g. "Forenoon", "Afternoon"
  createdAt DateTime  @default(now())

  exam      GateExam              @relation(fields: [examId], references: [id], onDelete: Cascade)
  subjects  GateSyllabusSubject[]
  resources GateResource[]
  questions GateQuestion[]
  mockTests GateMockTest[]

  @@unique([examId, paperCode])
  @@index([examId])
  @@map("gate_papers")
}

model GateSyllabusSubject {
  id               String   @id @default(cuid())
  paperId          String
  title            String
  weightagePercent Float?
  createdAt        DateTime @default(now())

  paper     GatePaper           @relation(fields: [paperId], references: [id], onDelete: Cascade)
  topics    GateSyllabusTopic[]
  questions GateQuestion[]

  @@index([paperId])
  @@map("gate_syllabus_subjects")
}

model GateSyllabusTopic {
  id          String   @id @default(cuid())
  subjectId   String
  title       String
  description String?  @db.Text
  createdAt   DateTime @default(now())

  subject   GateSyllabusSubject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  resources GateResource[]
  subtopics GateSubtopic[]
  questions GateQuestion[]

  prerequisitesGateTarget GateTopicPrerequisite[] @relation("TopicHasPrerequisite")
  prerequisitesGatePrereq GateTopicPrerequisite[] @relation("TopicIsPrerequisiteFor")

  mastery       GateTopicMastery[]
  revisionItems GateRevisionQueue[]
  studySessions GateStudySession[]

  @@index([subjectId])
  @@map("gate_syllabus_topics")
}

model GateSubtopic {
  id          String   @id @default(cuid())
  topicId     String
  title       String
  description String?  @db.Text
  createdAt   DateTime @default(now())

  topic GateSyllabusTopic @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@index([topicId])
  @@map("gate_subtopics")
}

model GateTopicPrerequisite {
  id            String   @id @default(cuid())
  targetTopicId String
  prereqTopicId String
  createdAt     DateTime @default(now())

  targetTopic GateSyllabusTopic @relation("TopicHasPrerequisite", fields: [targetTopicId], references: [id], onDelete: Cascade)
  prereqTopic GateSyllabusTopic @relation("TopicIsPrerequisiteFor", fields: [prereqTopicId], references: [id], onDelete: Cascade)

  @@unique([targetTopicId, prereqTopicId])
  @@index([targetTopicId])
  @@index([prereqTopicId])
  @@map("gate_topic_prerequisites")
}

model GateResource {
  id             String    @id @default(cuid())
  paperId        String
  subjectId      String?
  topicId        String?
  subtopicId     String?
  title          String
  description    String?   @db.Text
  url            String
  provider       String
  resourceType   String    // OFFICIAL_GATE, MOCK, VIDEO, COURSE, BOOK, etc.
  language       String    @default("ENGLISH")
  difficulty     String?   // BEGINNER, INTERMEDIATE, ADVANCED
  isPaid         Boolean   @default(false)
  isOfficial     Boolean   @default(true)
  tags           Json?
  isActive       Boolean   @default(true)
  verifiedAt     DateTime?
  lastVerifiedAt DateTime?
  createdAt      DateTime  @default(now())

  paper GatePaper          @relation(fields: [paperId], references: [id], onDelete: Cascade)
  subject GateSyllabusSubject? @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  topic GateSyllabusTopic? @relation(fields: [topicId], references: [id], onDelete: SetNull)
  actions GateUserResourceAction[]

  @@index([paperId])
  @@index([topicId])
  @@map("gate_resources")
}

model GateUserResourceAction {
  id           String    @id @default(cuid())
  userId       String
  resourceId   String
  actionType   String    // BOOKMARK, USEFUL, NOT_USEFUL, OPENED
  createdAt    DateTime  @default(now())

  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  resource GateResource  @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([resourceId])
  @@map("gate_user_resource_actions")
}

model UserGateProfile {
  id                      String   @id @default(cuid())
  userId                  String   @unique
  targetYear              Int
  targetPaperCode         String
  expectedScore           Float?
  targetRank              Int?
  weeklyStudyHours        Int      @default(10)
  preparationStage        String   @default("BEGINNER") // BEGINNER, INTERMEDIATE, ADVANCED
  preferredLearningFormat String   @default("VIDEO")
  diagnosticState         Json?
  createdAt               DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("user_gate_profiles")
}

model GateQuestion {
  id             String             @id @default(cuid())
  examId         String
  paperId        String
  subjectId      String?
  topicId        String?
  subtopicId     String?
  questionNumber Int?
  marks          Float
  questionType   GateQuestionType
  difficulty     GateDifficulty     @default(MEDIUM)
  concept        String?
  content        String             @db.Text
  options        Json?
  correctAnswer  String
  explanation    String?            @db.Text
  sourceUrl      String?
  sourceProvider String?
  status         GateOfficialStatus @default(UNOFFICIAL)
  version        Int                @default(1)
  createdAt      DateTime           @default(now())

  exam    GateExam             @relation(fields: [examId], references: [id], onDelete: Cascade)
  paper   GatePaper            @relation(fields: [paperId], references: [id], onDelete: Cascade)
  subject GateSyllabusSubject? @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  topic   GateSyllabusTopic?   @relation(fields: [topicId], references: [id], onDelete: SetNull)

  attempts  GateQuestionAttempt[]
  bookmarks GateBookmark[]
  mistakes  GateMistakeTracker[]

  @@index([examId])
  @@index([paperId])
  @@index([topicId])
  @@map("gate_questions")
}

model GateQuestionAttempt {
  id           String   @id @default(cuid())
  userId       String
  questionId   String
  userAnswer   String?
  isCorrect    Boolean
  timeSpentsMs Int      @default(0)
  createdAt    DateTime @default(now())

  user     User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  question GateQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([questionId])
  @@map("gate_question_attempts")
}

model GateBookmark {
  id         String   @id @default(cuid())
  userId     String
  questionId String
  notes      String?  @db.Text
  createdAt  DateTime @default(now())

  user     User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  question GateQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([userId, questionId])
  @@index([userId])
  @@map("gate_bookmarks")
}

model GateTopicMastery {
  id           String   @id @default(cuid())
  userId       String
  topicId      String
  masteryLevel Float // 0.0 to 100.0
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user  User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  topic GateSyllabusTopic @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@unique([userId, topicId])
  @@index([userId])
  @@map("gate_topic_mastery")
}

model GateMistakeTracker {
  id              String          @id @default(cuid())
  userId          String
  questionId      String
  mistakeType     GateMistakeType
  notes           String?         @db.Text
  correctApproach String?         @db.Text  // ADDED
  confidenceLevel String?         // HIGH, MEDIUM, LOW
  resolved        Boolean         @default(false)
  createdAt       DateTime        @default(now())

  user     User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  question GateQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([questionId])
  @@map("gate_mistake_tracker")
}

model GateRevisionQueue {
  id              String   @id @default(cuid())
  userId          String
  topicId         String
  lastReviewAt    DateTime? 
  nextReviewAt    DateTime
  reviewCount     Int      @default(0)
  performance     Float?   
  confidenceScore Float?
  createdAt       DateTime @default(now())

  user  User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  topic GateSyllabusTopic @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([nextReviewAt])
  @@map("gate_revision_queue")
}

model GateStudyPlan {
  id           String   @id @default(cuid())
  userId       String
  targetExamId String
  title        String
  startDate    DateTime
  endDate      DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user     User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  exam     GateExam           @relation(fields: [targetExamId], references: [id], onDelete: Cascade)
  sessions GateStudySession[]

  @@index([userId])
  @@map("gate_study_plans")
}

model GateStudySession {
  id           String                 @id @default(cuid())
  planId       String
  topicId      String?
  title        String
  date         DateTime
  durationMins Int
  status       GateStudySessionStatus @default(PLANNED)
  createdAt    DateTime               @default(now())

  plan  GateStudyPlan      @relation(fields: [planId], references: [id], onDelete: Cascade)
  topic GateSyllabusTopic? @relation(fields: [topicId], references: [id], onDelete: SetNull)

  @@index([planId])
  @@index([topicId])
  @@map("gate_study_sessions")
}

model GateMockTest {
  id           String   @id @default(cuid())
  examId       String
  paperId      String
  title        String
  description  String?  @db.Text
  durationMins Int      @default(180)
  totalMarks   Float    @default(100.0)
  isOfficial   Boolean  @default(false)
  createdAt    DateTime @default(now())

  exam      GateExam           @relation(fields: [examId], references: [id], onDelete: Cascade)
  paper     GatePaper          @relation(fields: [paperId], references: [id], onDelete: Cascade)
  questions GateMockQuestion[]
  attempts  GateMockAttempt[]

  @@index([examId])
  @@index([paperId])
  @@map("gate_mock_tests")
}

model GateMockQuestion {
  id               String           @id @default(cuid())
  mockId           String
  actualQuestionId String? // MUST LINK TO REAL QUESTION TO PREVENT FABRICATION
  questionText     String           @db.Text
  options          Json?
  correctAnswer    String
  marks            Float
  questionType     GateQuestionType
  createdAt        DateTime         @default(now())

  mock           GateMockTest     @relation(fields: [mockId], references: [id], onDelete: Cascade)
  actualQuestion GateQuestion?    @relation(fields: [actualQuestionId], references: [id], onDelete: SetNull)
  answers        GateMockAnswer[]

  @@index([mockId])
  @@index([actualQuestionId])
  @@map("gate_mock_questions")
}

model GateMockAnswer {
  id                String           @id @default(cuid())
  attemptId         String
  questionId        String
  answerText        String?          // For NAT
  selectedOptionIds String[]         // Array of IDs for MSQ/MCQ
  isSubjective      Boolean          @default(false)
  isCorrect         Boolean          @default(false)
  timeSpentSecs     Int              @default(0)
  createdAt         DateTime         @default(now())

  attempt  GateMockAttempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question GateMockQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([attemptId])
  @@index([questionId])
  @@map("gate_mock_answers")
}

model GateMockAttempt {
  id         String         @id @default(cuid())
  userId     String
  mockId     String
  status     GateMockStatus @default(IN_PROGRESS)
  score      Float          @default(0.0)
  totalTime  Int            @default(0)
  startedAt  DateTime       @default(now())
  finishedAt DateTime?
  createdAt  DateTime       @default(now())

  user    User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  mock    GateMockTest     @relation(fields: [mockId], references: [id], onDelete: Cascade)
  answers GateMockAnswer[]

  @@index([userId])
  @@index([mockId])
  @@map("gate_mock_attempts")
}

model GateReadinessSnapshot {
  id               String   @id @default(cuid())
  userId           String
  targetYear       Int
  overallReadiness Float
  metrics          Json     // Storing { syllabus, mastery, practice, etc. }
  createdAt        DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, targetYear])
  @@map("gate_readiness_snapshot")
}

model GateSyncRecord {
  id           String   @id @default(cuid())
  examId       String
  hashValue    String
  entityCount  Int
  status       String   // SUCCESS, FAILED
  errorMessage String?  @db.Text
  createdAt    DateTime @default(now())

  exam GateExam @relation(fields: [examId], references: [id], onDelete: Cascade)

  @@index([examId])
  @@index([hashValue])
  @@map("gate_sync_records")
}

model GateAdminAudit {
  id        String   @id @default(cuid())
  adminId   String
  action    String
  entityId  String
  details   Json?
  createdAt DateTime @default(now())

  admin     User     @relation(fields: [adminId], references: [id], onDelete: Cascade)
  
  @@index([adminId])
  @@index([entityId])
  @@map("gate_admin_audits")
}
